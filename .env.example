# Opcionális: a webshopban létrehozott, kétpalackos kosarat előállító bridge végpont.
# Amíg nincs beállítva, a CTA a hivatalos termékoldalra visz, nem állítja, hogy kosárba tett.
NEXT_PUBLIC_VGE_CHECKOUT_BRIDGE_URL=
NEXT_PUBLIC_VGE_PRODUCT_URL=https://uj.vitalgrapeessence.hu/termekek/vital-grape-essence

# A felugró kaparós játék CSAK akkor jelenik meg, ha a kódot beállítottad.
# Az itt megadott kódot ELŐBB a webshop /admin/kuponok oldalán kell
# létrehozni aktív 11%-os kuponként; különben a látogatók nem tudják beváltani.
# Legyen érvényes az egyszeri, VGE-csomagos ársorokra (1/2/3/6 palack stb.).
# Előfizetésre a jelenlegi webshop kuponrendszere nem ad kedvezményt.
NEXT_PUBLIC_VGE_SCRATCH_COUPON_CODE=
